# Supabase Configuration
# Get these values from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api

REACT_APP_SUPABASE_URL=your-project-url.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# App Configuration
REACT_APP_NAME=SOP App
REACT_APP_VERSION=1.1.0

# Feature Flags
REACT_APP_ENABLE_OFFLINE_MODE=true
REACT_APP_ENABLE_PWA=true

# Google Calendar (staff feature)
#
# The client ID is public: it is in the authorization URL every user is
# redirected to, and it is meant to ship in the bundle.
REACT_APP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
REACT_APP_GOOGLE_REDIRECT_URI=https://didc.app/auth/callback

# NEVER add the client secret here or anywhere else with a REACT_APP_ prefix.
# Every REACT_APP_* var is compiled into the public JS bundle. It lived here
# once, as REACT_APP_GOOGLE_CLIENT_SECRET, and was served in plain text from
# didc.app until it was moved into the google-oauth Edge Function.
#
# Server-side only, set on the Supabase functions:
#   google-oauth           GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
#   portal-calendar-sync   GOOGLE_SERVICE_ACCOUNT_JSON
