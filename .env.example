# Supabase Configuration
# Get these values from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api

REACT_APP_SUPABASE_URL=your-project-url.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# App Configuration
REACT_APP_NAME=SOP App
REACT_APP_VERSION=1.1.0

# Feature Flags
REACT_APP_ENABLE_OFFLINE_MODE=true
REACT_APP_ENABLE_PWA=true

# Client (parent) logins — CLIENT-AUTH-BUILD.md / CLIENT-AUTH-LAUNCH.md.
# Two flags, two stages:
#
#   REACT_APP_CLIENT_AUTH=true — the new login EXISTS and is reachable: the
#   /portal/login|signup|account routes register and a small "Client login ·
#   beta" button appears below the two main tiles on the front door. The
#   existing access-code portal is UNTOUCHED, so real families keep using it as
#   is while you test the login with a few test accounts. Safe to ship on its
#   own — it changes nothing for current clients.
#
#   REACT_APP_CLIENT_AUTH_REQUIRED=true — the full launch: the whole portal now
#   demands a login and the access-code path retires. This MUST land together
#   with applying supabase-migration-v30-close-anon-door.sql (which closes the
#   anonymous reads database-side). One without the other is either a login
#   nobody needs or a portal nobody can read. REQUIRED implies CLIENT_AUTH.
#
# Test stage:   REACT_APP_CLIENT_AUTH=true,  REACT_APP_CLIENT_AUTH_REQUIRED=false
# Launch stage: REACT_APP_CLIENT_AUTH=true,  REACT_APP_CLIENT_AUTH_REQUIRED=true  (+ apply v30)
REACT_APP_CLIENT_AUTH=false
REACT_APP_CLIENT_AUTH_REQUIRED=false

# Seasonal decoration on the front door — src/lib/holiday/flag.ts
#
# Names the holiday the front door is wearing. A small cast of characters then
# performs across the chooser on a loop: a ghost rising from behind one tile and
# sinking behind the other, a zombie shambling along a tile edge and falling off
# it, a bat that hangs under the logo, sleeps and flies away, a skeleton walking
# the bottom edge, and jack-o'-lanterns flickering throughout.
#
# Purely visual. It cannot intercept a tap (pointer-events: none), it is hidden
# from screen readers, and it appears on the front door only — never on a staff
# page somebody works in all day.
#
#   REACT_APP_HOLIDAY=halloween     turns it on, indefinitely
#   REACT_APP_HOLIDAY=off  (or unset, or anything unrecognised)  turns it off
#
# Valid values: halloween. (thanksgiving and christmas are reserved — the flag
# accepts them, but until those themes are built they render nothing.)
#
# THERE IS NO DATE AUTOMATION, DELIBERATELY. Nothing switches itself on in
# October. A seasonal decoration should appear because somebody decided it was
# time, and the deploy is that decision — an app that changes its appearance on
# a morning nobody deployed gets reported as broken. Turning it on and off are
# both an env change plus a redeploy, and both are meant to be.
#
# With it unset the chooser renders exactly the markup it rendered before this
# feature existed: no chunk is fetched and no art is downloaded.
REACT_APP_HOLIDAY=off

# Google Calendar (staff feature)
#
# The client ID is public: it is in the authorization URL every user is
# redirected to, and it is meant to ship in the bundle.
REACT_APP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
REACT_APP_GOOGLE_REDIRECT_URI=https://didc.app/auth/callback

# NEVER add the client secret here or anywhere else with a REACT_APP_ prefix.
# Every REACT_APP_* var is compiled into the public JS bundle. It lived here
# once, as REACT_APP_GOOGLE_CLIENT_SECRET, and was served in plain text from
# didc.app until it was moved into the google-oauth Edge Function.
#
# Server-side only, set on the Supabase functions:
#   google-oauth           GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
#   portal-calendar-sync   GOOGLE_SERVICE_ACCOUNT_JSON
