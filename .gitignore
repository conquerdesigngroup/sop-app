# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
._*
*.backup
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
.env*.local

# Local Netlify folder
.netlify

# environment files (never commit secrets)
.env
.env*
# ...except the example, which holds no values and is the only place the rule
# about REACT_APP_* being public is written down where a new clone will see it.
!.env.example

# Supabase CLI local state (machine-specific, never committed)
supabase/.temp/
supabase/.branches/
